{
  "name": "h5p-gaussian-splat",
  "version": "1.0.10",
  "description": "H5P content type for viewing 3D Gaussian splats (.ply and .sog)",
  "scripts": {
    "build": "node scripts/gen-lang.mjs && node build.mjs",
    "watch": "node build.mjs --watch --dev",
    "pack": "npm run build && node scripts/pack.mjs",
    "convert": "splat-transform"
  },
  "author": "Bruce Lockie",
  "license": "MIT",
  "devDependencies": {
    "@playcanvas/splat-transform": "^3.10.1",
    "axe-core": "^4.10.3",
    "esbuild": "^0.28.2",
    "h5p-standalone": "^3.8.2",
    "playcanvas": "2.23.3",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0"
  },
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/blockie82/h5p-gaussian-splat.git"
  },
  "homepage": "https://github.com/blockie82/h5p-gaussian-splat#readme",
  "keywords": [
    "h5p",
    "gaussian-splatting",
    "3dgs",
    "playcanvas",
    "moodle",
    "sog",
    "ply"
  ]
}
